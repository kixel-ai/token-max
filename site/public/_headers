# The page loads nothing from another origin; its one script and its fonts are its own.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/run.sh
  Content-Type: text/plain; charset=utf-8
/run.ps1
  Content-Type: text/plain; charset=utf-8
